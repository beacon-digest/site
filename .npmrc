# Supply-chain guard: refuse dependency versions published less than this many
# minutes ago (1440 = 24h). Gives the ecosystem time to catch a compromised
# release before it can land in our lockfile. Applied to local installs, CI,
# and cloud sessions so resolution is consistent everywhere.
minimum-release-age=1440

# Approve build scripts for native/binary packages required by the project.
# pnpm 11 blocks build scripts by default (security hardening); these are
# widely-trusted tools that need post-install compilation to function.
allow-build=@biomejs/biome;@parcel/watcher;esbuild
