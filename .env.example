GOOGLE_MAPS_API_KEY=

# Database (Neon Postgres)
VITE_DATABASE_URL=

# Notion sync
NOTION_API_KEY=
NOTION_DATABASE_ID=

# WorkOS AuthKit (admin panel). The admin panel/auth stays inactive until
# WORKOS_CLIENT_ID and WORKOS_API_KEY are set, so the public site is unaffected.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Must match the callback route below and be registered in the WorkOS dashboard.
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Used to encrypt the session cookie. Generate with: openssl rand -base64 24
WORKOS_COOKIE_PASSWORD=
# Only members of this WorkOS Organization can access /admin (staff org id).
WORKOS_STAFF_ORG_ID=
